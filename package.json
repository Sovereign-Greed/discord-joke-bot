{
  "name": "discord-joke-bot",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint . --ignore-pattern 'build/' --fix",
    "lint:check": "eslint . --ignore-pattern 'build/' --max-warnings 0",
    "lint:fix": "eslint . --ignore-pattern 'build/' --fix",
    "verify": "npm run lint:check",
    "verify:docker": "npm run lint:check && docker build -t discord-joke-bot:local .",
    "build": "npm run lint:check",
    "build:docker": "docker build -t discord-joke-bot:local .",
    "build:all": "npm run build && npm run build:docker",
    "build:babel": "babel src -d build",
    "fly:start": "fly scale count 1 --max-per-region 1 --app discord-joke-bot --yes",
    "fly:stop": "fly scale count 0 --app discord-joke-bot --yes",
    "fly:deploy": "fly deploy",
    "fly:machines": "fly machine list --app discord-joke-bot",
    "fly:scale-one": "npm run fly:start",
    "start": "node src/index.js",
    "dev": "nodemon",
    "check-env": "node src/check-env.js",
    "env:init": "node scripts/init-env.js",
    "deploy-commands": "node scripts/deploy-commands.js",
    "prestart": "node src/check-env.js"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.9",
    "discord.js": "^14.26.3",
    "dotenv": "^16.4.7",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@babel/cli": "^7.26.4",
    "@babel/core": "^7.26.7",
    "@babel/preset-env": "^7.26.7",
    "@eslint/js": "^9.19.0",
    "eslint": "^9.19.0",
    "nodemon": "^3.1.9"
  }
}
