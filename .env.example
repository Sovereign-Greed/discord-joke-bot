# Copy to .env (or run: npm run env:init)
# Discord Developer Portal → Your application → General Information

# Bot user token (Bot → Reset Token). Keep secret.
BOT_TOKEN=

# Application ID (same as the bot's user ID snowflake)
APPLICATION_ID=

# Interactions public key (64 hex chars). Needed for HTTP interactions verification or some tooling.
PUBLIC_KEY=

# Optional: first name or nickname for /roll natural-1 jokes (friend who rolls badly). Leave unset to disable.
BAD_ROLLER_NAME=
